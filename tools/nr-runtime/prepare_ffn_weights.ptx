// Research helper. One packed FP8 word -> two half2 words (bytes 0,2 and 1,3).
// Uses exactly the existing sm_86 kernel's bit operations and half multiply.
.version 8.0
.target sm_86
.address_size 64
.visible .entry trp_prepare_ffn_v1(
    .param .u64 source, .param .u64 target, .param .u64 words
)
{
    .reg .b32 %r<12>;
    .reg .b64 %q<9>;
    .reg .pred %p;
    ld.param.u64 %q0, [source];
    ld.param.u64 %q1, [target];
    ld.param.u64 %q2, [words];
    mov.u32 %r0, %ctaid.x;
    mov.u32 %r1, %ntid.x;
    mov.u32 %r2, %tid.x;
    mad.wide.u32 %q3, %r0, %r1, 0;
    cvt.u64.u32 %q4, %r2;
    add.u64 %q3, %q3, %q4;
    mov.u32 %r3, %nctaid.x;
    mul.wide.u32 %q4, %r3, %r1;
LOOP:
    setp.ge.u64 %p, %q3, %q2;
    @%p bra DONE;
    shl.b64 %q5, %q3, 2;
    add.u64 %q6, %q0, %q5;
    ld.global.u32 %r4, [%q6];
    and.b32 %r5, %r4, 0x007F007F;
    shl.b32 %r5, %r5, 7;
    and.b32 %r6, %r4, 0x00800080;
    shl.b32 %r6, %r6, 8;
    or.b32 %r7, %r5, %r6;
    mov.b32 %r11, 0x5C005C00;
    mul.rn.f16x2 %r7, %r7, %r11;
    and.b32 %r8, %r4, 0x7F007F00;
    shr.u32 %r8, %r8, 1;
    and.b32 %r9, %r4, 0x80008000;
    or.b32 %r10, %r8, %r9;
    mul.rn.f16x2 %r10, %r10, %r11;
    shl.b64 %q7, %q5, 1;
    add.u64 %q8, %q1, %q7;
    st.global.v2.u32 [%q8], {%r7, %r10};
    add.u64 %q3, %q3, %q4;
    bra LOOP;
DONE:
    ret;
}
