#version 460
#extension GL_GOOGLE_include_directive : require
#include "rounding.glsl"
layout(local_size_x=32) in;
layout(set=0,binding=0,std430) readonly buffer Inputs {uint input_bits[];};
layout(set=0,binding=1,std430) writeonly buffer Outputs {uvec2 output_bits[];};
layout(push_constant) uniform Params {uint count;} pc;
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=pc.count)return;
    float value=uintBitsToFloat(input_bits[i]);
    output_bits[i]=uvec2(nr_half_bits(value),nr_e4m3_bits(value));
}
