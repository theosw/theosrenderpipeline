cmake_minimum_required(VERSION 3.21)
get_filename_component(PACKAGE_ROOT "${PACKAGE_ROOT}" ABSOLUTE)
# The assembler consumes this explicit inventory. Fail on missing AND unlisted
# source payloads so a new package/SKSE file cannot silently disappear in a ZIP.
file(READ "${PACKAGE_ROOT}/PackageInventory.json" inventory)
string(JSON count LENGTH "${inventory}" files)
math(EXPR last "${count} - 1")
set(listed)
foreach(index RANGE ${last})
    string(JSON path GET "${inventory}" files ${index} path)
    string(JSON policy GET "${inventory}" files ${index} policy)
    string(JSON editions GET "${inventory}" files ${index} editions)
    string(JSON editionCount LENGTH "${editions}")
    string(JSON first GET "${editions}" 0)
    string(JSON second GET "${editions}" 1)
    if(NOT path MATCHES "^SKSE/" OR path MATCHES "\\.\\." OR path IN_LIST listed)
        message(FATAL_ERROR "Unsafe or duplicate package path: ${path}")
    endif()
    if(NOT editionCount EQUAL 2 OR NOT first STREQUAL "Standard" OR NOT second STREQUAL "Universal")
        message(FATAL_ERROR "Common source payload must ship in both editions: ${path}")
    endif()
    if(path MATCHES "^SKSE/Plugins/CommunityShaders/")
        if(NOT policy STREQUAL "replace")
            message(FATAL_ERROR "CS compatibility files must replace older copies: ${path}")
        endif()
    elseif(NOT policy STREQUAL "replace" AND NOT policy STREQUAL "preserve")
        message(FATAL_ERROR "Unknown package policy: ${path}: ${policy}")
    endif()
    list(APPEND listed "${path}")
endforeach()
file(GLOB_RECURSE actual LIST_DIRECTORIES FALSE RELATIVE "${PACKAGE_ROOT}" "${PACKAGE_ROOT}/SKSE/*")
list(SORT actual)
list(SORT listed)
if(NOT "${actual}" STREQUAL "${listed}")
    message(FATAL_ERROR "Package inventory differs from every file under package/SKSE.\nActual: ${actual}\nListed: ${listed}")
endif()
